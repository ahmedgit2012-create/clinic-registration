# انسخ هذا الملف إلى .env وعدّل القيم حسب الحاجة

PORT=3000
SESSION_SECRET=change-this-to-a-random-secret

# حسابات الموظفين الأولية (تُستخدم عند تشغيل: npm run seed)
# اتركها فارغة لتوليد كلمات مرور عشوائية تظهر في الطرفية مرة واحدة فقط
SECRETARY_USERNAME=secretary
SECRETARY_PASSWORD=

ENDOSCOPY_USERNAME=endoscopy
ENDOSCOPY_PASSWORD=

MANAGER_USERNAME=manager
MANAGER_PASSWORD=

# تعطيل مؤقت لتسجيل الدخول على كامل الموقع (كل زائر يصبح تلقائيًا بصلاحية مدير).
# للاستخدام في التجربة السريعة فقط — اتركها false أو احذف السطر في أي بيئة فعلية.
DISABLE_AUTH=false
